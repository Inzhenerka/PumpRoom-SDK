{
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "types",
      "node_modules/@types"
    ],
    "types": [
      "node",
      "vite/client",
      "highlightjs-copy"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "dom",
      "es2015"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
